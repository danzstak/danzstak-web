{
  "id": "/sync",
  "name": "SYNC by DanzStak",
  "short_name": "SYNC",
  "description": "Chats, calls and booking replies from DanzStak, as their own app. Same account, no second login.",
  "start_url": "/sync/?app=sync",
  "scope": "/sync/",
  "display": "standalone",
  "background_color": "#0b0b0c",
  "theme_color": "#0b0b0c",
  "orientation": "portrait",
  "categories": [
    "social",
    "communication"
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://danzstak.com/sync.webmanifest"
    }
  ],
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Chats",
      "url": "/sync/?app=sync",
      "icons": [
        {
          "src": "/assets/sync-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Booking replies",
      "url": "/sync/?app=sync&section=bookings",
      "icons": [
        {
          "src": "/assets/sync-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "icons": [
    {"src": "/assets/sync-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "/assets/sync-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "/assets/sync-icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ]
}
