{
  "name": "DanzStak — The Digital Clubhouse",
  "short_name": "DanzStak",
  "description": "The digital clubhouse for music culture, creators, and fans.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#edf2f7",
  "theme_color": "#1769e0",
  "orientation": "any",
  "categories": ["social", "entertainment"],
  "related_applications": [
    {"platform": "webapp", "url": "/manifest.webmanifest", "id": "https://danzstak.com/"}
  ],
  "prefer_related_applications": false,
  "shortcuts": [
    {"name": "Your Mix", "short_name": "Mix", "url": "/feed.html", "icons": [{"src": "/assets/favicon-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "Messages", "short_name": "Messages", "url": "/messages.html", "icons": [{"src": "/assets/favicon-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "My Profile", "short_name": "Profile", "url": "/profile.html", "icons": [{"src": "/assets/favicon-192.png", "sizes": "192x192", "type": "image/png"}]}
  ],
  "icons": [
    {
      "src": "/assets/favicon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/favicon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
