{
  "name": "DanzStak — The Digital Clubhouse",
  "short_name": "DanzStak",
  "description": "The digital clubhouse for music culture, creators, and fans.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b0b12",
  "theme_color": "#1769e0",
  "orientation": "any",
  "categories": ["social", "entertainment"],
  "related_applications": [
    {"platform": "webapp", "url": "/manifest.webmanifest", "id": "https://danzstak.com/"}
  ],
  "prefer_related_applications": false,
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {"title": "title", "text": "text", "url": "url", "files": [{"name": "media", "accept": ["image/jpeg", "image/png", "image/webp", "image/gif", "video/mp4", "video/quicktime", "video/webm"]}]}
  },
  "shortcuts": [
    {"name": "Your Mix", "short_name": "Mix", "url": "/feed.html", "icons": [{"src": "/assets/favicon-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "SYNC", "short_name": "SYNC", "url": "/sync/?app=sync", "icons": [{"src": "/assets/sync-icon-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "My Profile", "short_name": "Profile", "url": "/profile.html", "icons": [{"src": "/assets/favicon-192.png", "sizes": "192x192", "type": "image/png"}]}
  ],
  "icons": [
    {
      "src": "/assets/favicon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/favicon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
